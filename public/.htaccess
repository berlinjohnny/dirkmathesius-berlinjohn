# ─── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -MultiViews
RewriteEngine On

# ─── Fanpage: Dirks Solo-Kategorien gehoeren auf seine Seite ──────────────────
# Die Fanpage zeigt nur noch Arbeiten, die gemeinsam mit John entstanden sind.
# music/reportage/landscape/stills haben hier keine Bilder mehr — statt sie leer
# oder als 404 stehen zu lassen, leiten sie dauerhaft auf Dirks gleichnamige
# Seite. Linkkraft und Besucher gehen damit geschlossen zu ihm.
#
# Host-gebunden: greift nur auf der berlinjohn.de-Subdomain. Auf Dirks eigenem
# Server (der ohnehin deploy/htaccess.ionos nutzt) bleibt die Regel wirkungslos —
# sonst wuerde seine Seite auf sich selbst weiterleiten.
RewriteCond %{HTTP_HOST} berlinjohn\.de$ [NC]
RewriteRule ^(music|reportage|landscape|stills)\.html$ https://www.dirkmathesius.de/$1.html [R=301,L]

# ─── Fanpage: sport/people/publication sind in /photography.html aufgegangen ──
# Diese drei enthielten die Kollaborationen. Die liegen jetzt gesammelt in einer
# Uebersicht — 13 Bilder auf drei Rubriken zu verteilen ergab keine Kategorien,
# sondern drei fast leere Seiten. Anders als oben bleibt die Weiterleitung INTERN:
# der Inhalt ist hier, er wurde nur zusammengelegt.
RewriteCond %{HTTP_HOST} berlinjohn\.de$ [NC]
RewriteRule ^(sport|folks|publication)\.html$ /photography.html [R=301,L]

ErrorDocument 404 /404.html

# >>> SOFT-404-RIEGEL: nur echte Client-Routen fallen auf die SPA, alles andere
# auf einen echten 404 (siehe ErrorDocument oben). Ohne diese Verengung bejahte
# der alte Catch-all JEDEN erfundenen Pfad mit index.html — fuer Google eine
# Dublette der Startseite statt "gibt es nicht" (gemessen 2026-08-10).
#
# Die Positivliste ist ein Spiegel von src/App.tsx (<Route path=...>), nicht
# unabhaengig gepflegt — src/test/soft404-allowlist.test.ts haelt beide synchron.
# Echte Dateien/Ordner (robots.txt, sitemap.xml, Bilder, *.html-Rechtsseiten)
# treffen !-f/!-d nie und bleiben von diesen Regeln unberuehrt.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ /index.html [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^impressum/?$ /index.html [QSA,L]
# >>> SOFT-404-RIEGEL ENDE <<<
