# ─────────────────────────────────────────────────────────────────────────────
# EINE Wahrheit für die Domain + Integrationen.
# Alle Werte sind client-seitig sichtbar (kein echtes Secret) → im Repo ok.
#
# CUTOVER auf die offizielle Domain:
#   1) VITE_SITE_URL auf https://www.dirkmathesius.de setzen
#   2) node scripts/build-portfolio-manifest.mjs   (regeneriert sitemap/robots/JSON-LD/html)
#   3) npm run build                                (index.html bekommt %VITE_SITE_URL%)
# ─────────────────────────────────────────────────────────────────────────────

# Kanonische Basis-URL (ohne abschließenden Slash). Pre-Cutover: berlinjohn.de-Testbed.
VITE_SITE_URL=https://dirkmathesius.berlinjohn.de

# Seiten-Variante: "official" (Dirks Business-Seite) | "fanpage" (John-Subdomain).
# Leer = automatisch aus dem Host abgeleitet (dirkmathesius.de → official, sonst fanpage).
# Wir finalisieren zuerst Dirks offizielle Seite → hier explizit "official".
# Für die Fanpage-Vorschau lokal auf "fanpage" setzen. Subdomain erst NACH dem
# Live-Gang der offiziellen Seite auf "fanpage" umstellen (SEO-Canonical-Grund).
VITE_SITE_VARIANT=fanpage

# Google Analytics 4 (Consent Mode v2 + Cookie-Banner). G-XXXXXXX. Leer = kein
# Tracking + kein Banner (Testbed bleibt sauber, bis die echte ID gesetzt wird).
VITE_GA4_ID=G-NHPNTGY90D
# Optionale Google-Ads-Conversion-ID (AW-XXXXXXXXX). Leer = kein Ads-Tag.
VITE_GOOGLE_ADS_ID=

# Web3Forms Access-Key (kostenlos auf web3forms.com registrieren). Leer = Formular
# fällt automatisch auf mailto zurück.
VITE_WEB3FORMS_KEY=dd80ab94-365d-4abf-96d3-6c915369011b
